# Copy to .env.local to override vite settings.
# Hub (Go backend, contract: backend/docs/openapi.yaml) is the only API.
#   VITE_HUB_API=mock   — in-memory executable spec instead of the real hub
#   VITE_HUB_URL=/hub   — request prefix (default); vite proxies /hub/* to HUB_ADDR (:8081)
#                         keeping cookies same-origin. Set to "" when served same-origin.
#VITE_HUB_API=mock
#VITE_HUB_URL=/hub
