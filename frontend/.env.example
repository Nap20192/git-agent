# Copy to .env.local to override vite settings. The API adapter is the real
# backend over /api (proxied to :8080 in dev, see vite.config.ts).

# Hub (Go backend) adapter: mock by default (backend/docs/openapi.yaml is the
# contract, src/api/hub/mock.ts the executable spec). To talk to the real hub:
#   VITE_HUB_API=http   — switch the adapter
#   VITE_HUB_URL=/hub   — request prefix; vite proxies /hub/* to the hub
#                         (HUB_ADDR, default :8081) keeping cookies same-origin.
#                         Leave unset to send /api to the same origin.
#VITE_HUB_API=http
#VITE_HUB_URL=/hub
