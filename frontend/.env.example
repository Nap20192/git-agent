# Copy to .env.local to override vite settings. The API adapter is the real
# backend over /api (proxied to :8080 in dev, see vite.config.ts).

# Hub (Go backend) adapter: mock by default (backend/docs/openapi.yaml is the
# contract, src/api/hub/mock.ts the executable spec). Set to "http" once the
# Go hub is running.
#VITE_HUB_API=http
