# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=git-agent

# Langfuse (флаг включения обязателен — ключи без флага не включают трейсинг)
LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenSandbox
OPENSANDBOX_DOMAIN=localhost:8090
OPENSANDBOX_API_KEY=

# Postgres (deploy/docker-compose.yml)
DATABASE_URL=postgresql://git_agent:git_agent@localhost:5433/git_agent
# Тестовая БД (пусто = <DATABASE_URL-db>_test, т.е. git_agent_test); тесты пишут сюда
TEST_DATABASE_URL=

# API-ключ модели (раскомментируй нужный)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# LLM (OpenAI-совместимый endpoint)
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# HTTP-gateway
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Песочница
SANDBOX_IMAGE=alpine/git:latest

# CVE MCP (security-режим): путь к cve-mcp-server (stdio через uv run); пусто = выкл
CVE_MCP_PATH=
NVD_API_KEY=

# Go-бекенд hub (backend/cmd/hub)
HUB_ADDR=:8081
# Токен саморегистрации раннеров (X-Runner-Token)
RUNNER_TOKEN=
# AES-256-ключ шифрования секретов в БД: 64 hex-символа (openssl rand -hex 32)
SECRETS_KEY=
# Публичный URL для вебхуков провайдеров (dev — cloudflared-туннель)
WEBHOOK_BASE_URL=
# RabbitMQ (deploy/docker-compose.yml, хост-порт 5673)
RABBITMQ_URL=amqp://guest:guest@localhost:5673/
# Раннер без heartbeat дольше N секунд считается мёртвым (Экземпляры → down, События → outbox)
HEARTBEAT_TIMEOUT_SECONDS=30
# Ожидание первого байта SSE-чата от раннера (он ставит запросы в очередь при занятых слотах)
CHAT_FIRST_BYTE_TIMEOUT_SECONDS=120

# OAuth-вход (тикет 003; без ключей провайдер недоступен — 503, сервис работает)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# Redirect после входа
FRONTEND_URL=http://localhost:5173

# Раннер (консьюмер Событий RabbitMQ)
RABBIT_URL=amqp://guest:guest@localhost:5673/
RUNNER_NAME=runner-1
RUNNER_ADDRESS=http://localhost:8082
RUNNER_PORT=8082
RUNNER_SLOTS=2
RUNNER_IDLE_TIMEOUT_SECONDS=900
# Регистрация/heartbeat в hub (он слушает :8081); пусто = выключено, недоступен = warn+retry
HUB_URL=http://localhost:8081
RUNNER_TOKEN=
# AES-GCM ключ полей hub.*_enc (base64, 32 байта); формат: nonce(12) || ciphertext
HUB_ENC_KEY=
